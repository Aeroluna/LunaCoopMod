//--------------------------------------------------------------------------------------------------
// Trigger: Setup Pings
//--------------------------------------------------------------------------------------------------
bool gt_SetupPings_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_iter;

    // Automatic Variable Declarations
    unitgroup auto050C889F_g;
    int auto050C889F_u;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    auto050C889F_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto050C889F_u = UnitGroupCount(auto050C889F_g, c_unitCountAll);
    for (;; auto050C889F_u -= 1) {
        lv_iter = UnitGroupUnitFromEnd(auto050C889F_g, auto050C889F_u);
        if (lv_iter == null) { break; }
        if ((UnitGetType(lv_iter) == "HybridDominatorVoid")) {
            continue;
        }

        GenerateUnitPing(lv_iter);
    }
    TriggerEnable(lib1_gt_LIB_UnitCreate, true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_SetupPings_Init () {
    gt_SetupPings = TriggerCreate("gt_SetupPings_Func");
    libCOUI_gf_CU_CommanderClosed(gt_SetupPings);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Player Base Revealer
//--------------------------------------------------------------------------------------------------
bool gt_PlayerBaseRevealer_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libCOMI_gf_AutoRevealRegionCoop(RegionFromId(18), RegionFromId(18), 1);
    libCOMI_gf_AutoRevealRegionCoop(RegionFromId(18), RegionFromId(18), 2);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_PlayerBaseRevealer_Init () {
    gt_PlayerBaseRevealer = TriggerCreate("gt_PlayerBaseRevealer_Func");
    TriggerAddEventMapInit(gt_PlayerBaseRevealer);
}

