// Trigger Initialization
//--------------------------------------------------------------------------------------------------
void InitTriggers () {
    gt_MothershipForceMove_Init();
    gt_MothershipAttackBehavior_Init();
    gt_MothershipEnemiesAreNearBehavior_Init();
    gt_TW_Main_Thread_Player01_Template_Init();
