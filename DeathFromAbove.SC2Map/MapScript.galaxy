include "TriggerLibs/NativeLib"
include "LibCOMI"
include "Lib01833E95"

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
void InitLibs () {
    libNtve_InitLib();
    libCOMI_InitLib();
    lib01833E95_InitLib();
}

//--------------------------------------------------------------------------------------------------
// Constants
//--------------------------------------------------------------------------------------------------
const fixed gv_mothershipMaxSpeed = 1.2;
const fixed gv_mothershipNearSpeed = 0.8;
const fixed gv_mothershipMinSpeed = 0.4;

//--------------------------------------------------------------------------------------------------
// Global Variables
//--------------------------------------------------------------------------------------------------
point gv_mothershipTarget;

void InitGlobals () {
}

//--------------------------------------------------------------------------------------------------
// Trigger Variables
//--------------------------------------------------------------------------------------------------
trigger gt_MothershipForceMove;
trigger gt_MothershipAttackBehavior;
trigger gt_MothershipEnemiesAreNearBehavior;
trigger gt_TW_Main_Thread_Player01_Template;
trigger gt_TW_Main_Thread_Player02_Template;

//--------------------------------------------------------------------------------------------------
// Custom Script: script
//--------------------------------------------------------------------------------------------------
include "TriggerLibs/MapScriptCustom"

//--------------------------------------------------------------------------------------------------
// Custom Script Initialization
//--------------------------------------------------------------------------------------------------
void InitCustomScript () {
    InitMapCustom();
}

//--------------------------------------------------------------------------------------------------
// Trigger: MothershipForceMove
//--------------------------------------------------------------------------------------------------
bool gt_MothershipForceMove_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitIsAlive(gv_mothership) == true))) {
            return false;
        }

        if (!((gv_mothershipTarget != null))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitIssueOrder(gv_mothership, OrderTargetingPoint(AbilityCommand("move", 0), gv_mothershipTarget), c_orderQueueReplace);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MothershipForceMove_Init () {
    gt_MothershipForceMove = TriggerCreate("gt_MothershipForceMove_Func");
    TriggerAddEventTimePeriodic(gt_MothershipForceMove, 1.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: MothershipAttackBehavior
//--------------------------------------------------------------------------------------------------
bool gt_MothershipAttackBehavior_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!((libCOMI_gf_GameIsOver() == false))) {
            return false;
        }

        if (!((UnitIsAlive(gv_mothership) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerEnable(gt_MothershipEnemiesAreNearBehavior, false);
    UnitSetPropertyFixed(gv_mothership, c_unitPropMovementSpeed, gv_mothershipMinSpeed);
    Wait(7.0, c_timeGame);
    UnitSetPropertyFixed(gv_mothership, c_unitPropMovementSpeed, gv_mothershipMaxSpeed);
    TriggerEnable(gt_MothershipEnemiesAreNearBehavior, true);
    TriggerEnable(TriggerGetCurrent(), true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MothershipAttackBehavior_Init () {
    gt_MothershipAttackBehavior = TriggerCreate("gt_MothershipAttackBehavior_Func");
    TriggerAddEventUnitDamaged(gt_MothershipAttackBehavior, UnitRefFromVariable("gv_mothership"), c_unitDamageTypeAny, c_unitDamageEither, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: MothershipEnemiesAreNearBehavior
//--------------------------------------------------------------------------------------------------
bool gt_MothershipEnemiesAreNearBehavior_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!((libCOMI_gf_GameIsOver() == false))) {
            return false;
        }

        if (!((UnitIsAlive(gv_mothership) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGroupCount(UnitGroupAlliance(gv_pLAYER_05_TALDARIM, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(gv_mothership), 12.0), UnitFilter(0, 0, (1 << c_targetFilterMissile) | (1 << c_targetFilterCloaked), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) > 0)) {
        UnitSetPropertyFixed(gv_mothership, c_unitPropMovementSpeed, gv_mothershipNearSpeed);
    }
    else {
        UnitSetPropertyFixed(gv_mothership, c_unitPropMovementSpeed, gv_mothershipMaxSpeed);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MothershipEnemiesAreNearBehavior_Init () {
    gt_MothershipEnemiesAreNearBehavior = TriggerCreate("gt_MothershipEnemiesAreNearBehavior_Func");
    TriggerAddEventTimePeriodic(gt_MothershipEnemiesAreNearBehavior, 1.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: TW_Main_Thread_Player01_Template
//--------------------------------------------------------------------------------------------------
bool gt_TW_Main_Thread_Player01_Template_Func (bool testConds, bool runActions) {
    // Variable Declarations
    const int lv_cPlayer = 1;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((PlayerStatus(lv_cPlayer) == c_playerStatusActive))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    BankLoad("MMTwitchIntegration", 1);
    lib01833E95_gf_TW_SetUp(lv_cPlayer, BankLastCreated());
    while (true) {
        if ((PlayerStatus(lv_cPlayer) != c_playerStatusActive)) {
            break;
        }

        BankReload(lib01833E95_gv_tW_Bank[lv_cPlayer]);
        BankWait(lib01833E95_gv_tW_Bank[lv_cPlayer]);
        lib01833E95_gf_TW_ActionCycle(lv_cPlayer);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_TW_Main_Thread_Player01_Template_Init () {
    gt_TW_Main_Thread_Player01_Template = TriggerCreate("gt_TW_Main_Thread_Player01_Template_Func");
    TriggerAddEventMapInit(gt_TW_Main_Thread_Player01_Template);
}

