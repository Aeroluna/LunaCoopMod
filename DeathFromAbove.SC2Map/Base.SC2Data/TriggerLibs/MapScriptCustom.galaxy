//--------------------------------------------------------------------------------------------------
// Trigger: Start Game Q
//--------------------------------------------------------------------------------------------------
bool gt_StartGameQ_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    libLbty_gf_OrderWorkerstoGatherNearbyResources(RegionEntireMap(), gv_pLAYER_01_USER);
    libLbty_gf_OrderWorkerstoGatherNearbyResources(RegionEntireMap(), gv_pLAYER_02_USER);
    UIAlertPoint("Trigger", gv_pLAYER_01_USER, StringExternal("Param/Value/09DDFAF2"), null, PlayerStartLocation(gv_pLAYER_01_USER));
    UIAlertPoint("Trigger", gv_pLAYER_02_USER, StringExternal("Param/Value/69DB9E62"), null, PlayerStartLocation(gv_pLAYER_02_USER));
    libHots_gf_PlaySoundLinkasMusic(SoundLink("LOTV_Music_P09Full", -1), false, false);
    TriggerEnable(gt_Fissure_Event, false);
    // TriggerEnable(gt_DestroyAttackWavePing, false);
    // TriggerEnable(gt_DestroyAttackWavePing2, false);
    // TriggerEnable(gt_DestroyAttackWavePing3, false);
    // TriggerEnable(gt_DestroyAttackWavePing4, false);
    // TriggerEnable(gt_DestroyBonusAttackWavePing, false);
    // TriggerEnable(gt_DestroyAttackMothershipPing2, false);
    //TriggerExecute(gt_Upgrades, true, false);
    Wait(5.0, c_timeGame);
    libCOMI_gf_CreateObjectiveCampaign("AC_DeathFromAbove_Primary01");
    gv_objective_CorruptionShards = ObjectiveLastCreated();
    Wait(2.0, c_timeGame);
    TriggerQueueEnter();
    SoundPlayForPlayer(SoundLink("Dialogue_TransmissionStart", -1), c_maxPlayers, PlayerGroupAll(), 150.0, 0.0);
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Speech);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(265550710), true, false, "Talk"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", SoundLink("Zaladas_Intro01", -1), StringExternal("Param/Value/85BDDA54"), StringExternal("Param/Value/4769BBE4"), 0.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Game);
    TriggerQueueExit();
    Wait(2.0, c_timeGame);
    libCOMI_gf_CreateObjectiveCampaign("AC_DeathFromAbove_Primary02");
    gv_objective_Mothership = ObjectiveLastCreated();
    SoundPlayForPlayer(SoundLink("UI_ZergWarningPing", -1), c_maxPlayers, PlayerGroupAll(), 150.0, 0.0);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Obelisk", 0, gv_pLAYER_05_TALDARIM, PointFromId(135147310));
    gv_projector = UnitLastCreated();
    libNtve_gf_ShareVisionofUnit(gv_projector, true, 1);
    libNtve_gf_ShareVisionofUnit(gv_projector, true, 2);
    SoundPlayAtPointForPlayer(SoundLink("VoidTendrilDeathGripSpawnBeamSound2", -1), c_maxPlayers, PlayerGroupAll(), PointFromId(135147310), 0.0, 300.0, 0.0);
    libNtve_gf_SendActorMessageToUnit(gv_projector, "ModelSwap Obelisk2");
    libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(gv_projector), c_animNameDefault, "Birth", 0, c_animTimeDefault);
    Wait(3.6, c_timeGame);
    SoundPlayAtPointForPlayer(SoundLink("VoidTendrilDeathGripSpawnBeamSound22", -1), c_maxPlayers, PlayerGroupAll(), PointFromId(135147310), 0.0, 300.0, 0.0);
    libNtve_gf_SendActorMessageToUnit(gv_projector, "ModelSwap Obelisk");
    libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(gv_projector), c_animNameDefault, "Birth", 0, c_animTimeDefault);
    Wait(3.0, c_timeGame);
    libNtve_gf_ClearAnimation(libNtve_gf_MainActorofUnit(gv_projector), c_animNameDefault);
    TriggerExecute(gt_EnemyAttackWaveQ1, true, false);
    TriggerQueueEnter();
    SoundPlayForPlayer(SoundLink("Dialogue_TransmissionStart", -1), c_maxPlayers, PlayerGroupAll(), 150.0, 0.0);
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Speech);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(265550710), true, false, "Talk"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", SoundLink("Zaladas_Intro02", -1), StringExternal("Param/Value/D7AED938"), StringExternal("Param/Value/E871FB8A"), 0.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Game);
    TriggerQueueExit();
    Wait(20.0, c_timeGame);
    VisRevealArea(1, RegionFromId(26), 32767.0, false);
    VisRevealArea(1, RegionFromId(25), 32767.0, false);
    VisRevealArea(2, RegionFromId(26), 32767.0, false);
    VisRevealArea(2, RegionFromId(25), 32767.0, false);
    PingCreate(PlayerGroupAll(), "PingCircle", PointFromId(125492154), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 524287.0);
    PingSetScale(PingLastCreated(), 0.3);
    PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/5F052674"));
    PingCreate(PlayerGroupAll(), "PingCircle", PointFromId(2108925997), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 524287.0);
    PingSetScale(PingLastCreated(), 0.3);
    PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/75F2A3F2"));
    PingCreate(PlayerGroupAll(), "PingCircle", PointFromId(2097863814), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 524287.0);
    PingSetScale(PingLastCreated(), 0.3);
    PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/D1447341"));
    SoundPlayForPlayer(SoundLink("UI_ZergWarningPing", -1), c_maxPlayers, PlayerGroupAll(), 150.0, 0.0);
    PingCreate(PlayerGroupAll(), "PingWarning", PointFromId(125492154), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 4.0);
    PingCreate(PlayerGroupAll(), "PingWarning", PointFromId(2108925997), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 4.0);
    PingCreate(PlayerGroupAll(), "PingWarning", PointFromId(2097863814), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 4.0);
    TriggerQueueEnter();
    SoundPlayForPlayer(SoundLink("Dialogue_TransmissionStart", -1), c_maxPlayers, PlayerGroupAll(), 150.0, 0.0);
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Speech);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(265550710), true, false, "Talk"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", SoundLink("Zaladas_Intro023", -1), StringExternal("Param/Value/59493FF5"), StringExternal("Param/Value/DBE1E04C"), 0.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Game);
    TriggerQueueExit();
    TriggerEnable(gt_Fissure_Event, true);
    Wait(70.0, c_timeGame);
    TriggerQueueEnter();
    SoundPlayForPlayer(SoundLink("Dialogue_TransmissionStart", -1), c_maxPlayers, PlayerGroupAll(), 150.0, 0.0);
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Speech);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(265550710), true, false, "Talk"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", SoundLink("Zaladas_Intro022", -1), StringExternal("Param/Value/5B6741CC"), StringExternal("Param/Value/7131F653"), 0.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Game);
    TriggerQueueExit();
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "SOAMothershipv42", 0, 0, PointFromId(846086050));
    gv_mothership_Shadow = UnitLastCreated();
    UnitIssueOrder(gv_mothership_Shadow, OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(135147310)), c_orderQueueReplace);
    //PingCreate(PlayerGroupAll(), "PingObjective", PointFromId(135147310), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 524287.0);
    libCOMI_gf_CreateObjectivePingAC(libCOMI_ge_ObjectivePingType_Primary, PointFromId(135147310), StringExternal("Param/Value/410516BD"));
    gv_shadow01 = PingLastCreated();
    PingSetScale(gv_shadow01, 1.0);
    PingSetUnit(gv_shadow01, gv_mothership_Shadow);
    Wait(18.0, c_timeGame);
    SoundPlayAtPointForPlayer(SoundLink("VoidTendrilDeathGripSpawnBeamSound222", -1), c_maxPlayers, PlayerGroupAll(), PointFromId(135147310), 0.0, 300.0, 0.0);
    libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(gv_projector), c_animNameDefault, "Stand Work Start", 0, c_animTimeDefault);
    Wait(6.6, c_timeGame);
    libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(gv_projector), c_animNameDefault, "Stand Work", c_animFlagPlayForever, c_animTimeDefault);
    libCOUI_gf_DisplayProgressBar(StringExternal("Param/Value/999C0559"), 0, 100);
    libCOUI_gf_SetProgressBarLabel(((IntToText(gv_charging_Integer) + (StringExternal("Param/Value/3C33502E")))));
    libCOUI_gf_SetProgressBarProgress(gv_charging_Integer);
    libCOUI_gf_SetProgressBarColor(Color(0.00, 100.00, 0.00));
    TriggerEnable(gt_MothershipCharge, true);
    SoundPlayForPlayer(SoundLink("UI_ZergWarningPing", -1), c_maxPlayers, PlayerGroupAll(), 150.0, 0.0);
    PingCreate(PlayerGroupAll(), "PingAlert", PointFromId(1534767828), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 40.0);
    gv_shard01 = PingLastCreated();
    PingSetTooltip(gv_shard01, StringExternal("Param/Value/942DEA4D"));
    PingSetScale(gv_shard01, 0.6);
    VisRevealArea(1, RegionFromId(5), 0.1, false);
    VisRevealArea(2, RegionFromId(5), 0.1, false);
    TriggerEnable(gt_DefeatBaseDeadPlayer1, true);
    TriggerEnable(gt_DefeatBaseDeadPlayer2, true);
    return true;
}

