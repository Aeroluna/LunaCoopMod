//--------------------------------------------------------------------------------------------------
void gt_Fissure_Event_Init () {
    gt_Fissure_Event = TriggerCreate("gt_Fissure_Event_Func");
    TriggerEnable(gt_Fissure_Event, false);
    TriggerAddEventTimePeriodic(gt_Fissure_Event, 90.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Gas_Players
//--------------------------------------------------------------------------------------------------
bool gt_Gas_Players_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "NaturalGas50"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperAdd, 50);
    PlayerModifyPropertyInt(2, c_playerPropVespene, c_playerPropOperAdd, 50);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Gas_Players_Init () {
    gt_Gas_Players = TriggerCreate("gt_Gas_Players_Func");
    TriggerAddEventUnitDied(gt_Gas_Players, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Mothership_UnderAttack
//--------------------------------------------------------------------------------------------------
bool gt_Mothership_UnderAttack_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerQueueEnter();
    SoundPlayForPlayer(SoundLink("Dialogue_TransmissionStart", -1), c_maxPlayers, PlayerGroupAll(), 150.0, 0.0);
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Speech);
    libCOMI_gf_SendMissionTransmission("EscortUnderAttack", true, RandomInt(gv_pLAYER_01_USER, gv_pLAYER_02_USER));
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Game);
    TriggerQueueExit();
    Wait(60.0, c_timeGame);
    TriggerEnable(TriggerGetCurrent(), true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Mothership_UnderAttack_Init () {
    gt_Mothership_UnderAttack = TriggerCreate("gt_Mothership_UnderAttack_Func");
    TriggerAddEventUnitAttacked2(gt_Mothership_UnderAttack, UnitRefFromVariable("gv_mothership"), null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: ShardPing
//--------------------------------------------------------------------------------------------------
bool gt_ShardPing_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    gv_voidCorruptionObjective += 1;
    libCOMI_gf_SetMissionObjectiveProgress("AC_DeathFromAbove_Primary01", gv_voidCorruptionObjective);
    PingDestroy(gv_shard01);
    UnitKill(gv_beam1);
    UnitKill(gv_beam2);
    UnitKill(gv_beam3);
    UnitSetHeight(gv_mothership, 8.0, 4.0);
    libNtve_gf_SendActorMessageToUnit(gv_mothership, "AnimBracketStop Work");
    TriggerEnable(gt_Mothership_UnderAttack, false);
    UnitSetPosition(gv_mothership, PointFromId(1534767828), false);
    //Wait(1.0, c_timeGame);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Artosilope", 0, gv_pLAYER_05_TALDARIM, PointFromId(1534767828));
    Wait(2.0, c_timeGame);
    UnitRemove(UnitLastCreated());
    Wait(2.0, c_timeGame);
    //libNtve_gf_SendActorMessageToUnit(gv_mothership, "ModelSwap TalDarimMothership22");
    libNtve_gf_SendActorMessageToUnit(gv_mothership, "Signal TeleportOut");
    libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(gv_mothership), c_animNameDefault, "Birth", 0, c_animTimeDefault);
    Wait(3.0, c_timeGame);
    UnitRemove(gv_mothership);
    gv_mothershipTarget = null;
    PingDestroy(gv_mothership_Ping);
    libCOUI_gf_ShowHideSingularBossBarVoidCampaign(false);
    UnitGroupLoopBegin(UnitGroup("KaiserWormScourgeMissile", 5, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0));
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        UnitRemove(UnitGroupLoopCurrent());
    }
    UnitGroupLoopEnd();
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "SOAMothershipv42", 0, 0, PointFromId(135147310));
    gv_mothership_Shadow = UnitLastCreated();
    PingCreate(PlayerGroupAll(), "PingObjective", PointFromId(135147310), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 524287.0);
    gv_shadow01 = PingLastCreated();
    PingSetScale(gv_shadow01, 1.0);
    PingSetTooltip(gv_shadow01, StringExternal("Param/Value/68994D53"));
    PingSetUnit(gv_shadow01, gv_mothership_Shadow);
    VisRevealArea(1, RegionFromId(6), 0.1, false);
    VisRevealArea(2, RegionFromId(6), 0.1, false);
    VisRevealArea(1, RegionFromId(7), 0.1, false);
    VisRevealArea(2, RegionFromId(7), 0.1, false);
    SoundPlayForPlayer(SoundLink("UI_ZergWarningPing", -1), c_maxPlayers, PlayerGroupAll(), 150.0, 0.0);
    PingCreate(PlayerGroupAll(), "PingAlert", PointFromId(143381561), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 40.0);
    gv_shard02 = PingLastCreated();
    PingSetTooltip(gv_shard02, StringExternal("Param/Value/E844B32A"));
    PingSetScale(gv_shard02, 0.6);
    PingCreate(PlayerGroupAll(), "PingAlert", PointFromId(1250167575), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 40.0);
    gv_shard03 = PingLastCreated();
    PingSetTooltip(gv_shard03, StringExternal("Param/Value/60E80693"));
    PingSetScale(gv_shard03, 0.6);
    TriggerQueueEnter();
    SoundPlayAtPointForPlayer(SoundLink("UI_TransmissionStart", -1), c_maxPlayers, PlayerGroupAll(), PointFromId(135147310), 0.0, 150.0, 0.0);
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Speech);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(265550710), true, false, "Talk"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", SoundLink("Zaladas_Intro022222", -1), StringExternal("Param/Value/78B84A01"), StringExternal("Param/Value/0394556A"), 0.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Game);
    TriggerQueueExit();
    SoundPlayAtPointForPlayer(SoundLink("VoidTendrilDeathGripSpawnBeamSound222", -1), c_maxPlayers, PlayerGroupAll(), PointFromId(135147310), 0.0, 200.0, 0.0);
    libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(gv_projector), c_animNameDefault, "Stand Work Start", 0, c_animTimeDefault);
    Wait(6.6, c_timeGame);
    libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(gv_projector), c_animNameDefault, "Stand Work", c_animFlagPlayForever, c_animTimeDefault);
    gv_charging_Integer -= 100;
    libCOUI_gf_ShowHideProgressBar(true);
    libCOUI_gf_DisplayProgressBar(StringExternal("Param/Value/48166C6A"), 0, 100);
    libCOUI_gf_SetProgressBarLabel(((IntToText(gv_charging_Integer) + (StringExternal("Param/Value/5DEFBF9B")))));
    libCOUI_gf_SetProgressBarProgress(gv_charging_Integer);
    libCOUI_gf_SetProgressBarColor(Color(0.00, 100.00, 0.00));
    Wait(2.0, c_timeGame);
    TriggerEnable(gt_Charging_Finish2, true);
    TriggerEnable(gt_MothershipCharge, true);
    //TriggerExecute(gt_VoidChasmStartQ, true, false);
    Wait(2.0, c_timeGame);
    TriggerExecute(gt_EnemyAttackWaveQ2, true, false);
    Wait(10.0, c_timeGame);
    TriggerExecute(gt_BonusAttackWave2, true, false);
    return true;
}

