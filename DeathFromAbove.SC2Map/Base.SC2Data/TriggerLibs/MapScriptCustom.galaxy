void gt_BonusObjective1Activate_Init () {
    gt_BonusObjective1Activate = TriggerCreate("gt_BonusObjective1Activate_Func");
    TriggerAddEventUnitRegion(gt_BonusObjective1Activate, null, RegionFromId(43), true);
}

