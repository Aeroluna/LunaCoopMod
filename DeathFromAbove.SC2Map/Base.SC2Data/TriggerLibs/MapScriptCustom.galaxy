    PingCreate(PlayerGroupAll(), "PingAlert", PointFromId(1786460183), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 40.0);
    gv_shard06 = PingLastCreated();
    PingSetTooltip(gv_shard06, StringExternal("Param/Value/EF714189"));
    PingSetScale(gv_shard06, 0.6);
    PingCreate(PlayerGroupAll(), "PingAlert", PointFromId(1296701021), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 40.0);
    gv_shard07 = PingLastCreated();
    PingSetTooltip(gv_shard07, StringExternal("Param/Value/91AAFF5D"));
    PingSetScale(gv_shard07, 0.6);
    PingCreate(PlayerGroupAll(), "PingAlert", PointFromId(934486428), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 40.0);
    gv_shard10 = PingLastCreated();
    PingSetTooltip(gv_shard10, StringExternal("Param/Value/12C4A5FD"));
