//--------------------------------------------------------------------------------------------------
// Trigger: Wave5_MS_Area1
//--------------------------------------------------------------------------------------------------
bool gt_Wave5_MS_Area1_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_pLAYER_05_TALDARIM))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    UnitIssueOrder(gv_mothership, OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(1786460183)), c_orderQueueReplace);
    gv_mothershipTarget = PointFromId(1786460183);
    TriggerExecute(gt_BonusAttackWave11, true, false);
    return true;
}

