//--------------------------------------------------------------------------------------------------
// Trigger: Init 02 Players
//--------------------------------------------------------------------------------------------------
bool gt_Init02Players_Func (bool testConds, bool runActions) {
    playergroup auto7AA9C5CB_g;
    int auto7AA9C5CB_p;
    playergroup auto5169EB00_g;
    int auto5169EB00_p;

    // Variable Declarations
    int lv_playerIterEnemy;
    int lv_playerIterAlly;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetPlayerGroupAlliance(libCOOC_gf_HumanPlayers(), libNtve_ge_AllianceSetting_AllyWithSharedVisionAndPushable);
    libNtve_gf_SetAlliance(gv_pLAYER_01_USER, gv_pLAYER_05_TALDARIM, libNtve_ge_AllianceSetting_AllyWithSharedVision);
    libNtve_gf_SetAlliance(gv_pLAYER_02_USER, gv_pLAYER_05_TALDARIM, libNtve_ge_AllianceSetting_AllyWithSharedVision);
    libNtve_gf_SetAlliance(gv_pLAYER_05_TALDARIM, gv_pLAYER_01_USER, libNtve_ge_AllianceSetting_AllyWithSharedVision);
    libNtve_gf_SetAlliance(gv_pLAYER_05_TALDARIM, gv_pLAYER_02_USER, libNtve_ge_AllianceSetting_AllyWithSharedVision);
    PlayerGroupAdd(gv_enemyGroup, gv_pLAYER_03_ENEMY);
    PlayerGroupAdd(gv_enemyGroup, gv_pLAYER_04_ENEMY);
    libNtve_gf_SetPlayerGroupAlliance(gv_enemyGroup, libNtve_ge_AllianceSetting_AllyWithSharedVisionAndPushable);
    auto7AA9C5CB_g = gv_enemyGroup;
    auto7AA9C5CB_p = 1;
    for ( ; auto7AA9C5CB_p <= PlayerGroupCount(auto7AA9C5CB_g) ; auto7AA9C5CB_p += BoolToInt(lv_playerIterEnemy == PlayerGroupPlayer(auto7AA9C5CB_g, auto7AA9C5CB_p)) ) {
        lv_playerIterEnemy = PlayerGroupPlayer(auto7AA9C5CB_g, auto7AA9C5CB_p);
        PlayerSetState(lv_playerIterEnemy, c_playerStateMineralCostIgnored, true);
        PlayerSetState(lv_playerIterEnemy, c_playerStateVespeneCostIgnored, true);
        PlayerSetState(lv_playerIterEnemy, c_playerStateFoodIgnored, true);
        PlayerSetColorIndex(lv_playerIterEnemy, libCOMI_gf_EnemyPlayerColor(), true);
        auto5169EB00_g = libCOOC_gf_HumanPlayers();
        auto5169EB00_p = 1;
        for ( ; auto5169EB00_p <= PlayerGroupCount(auto5169EB00_g) ; auto5169EB00_p += BoolToInt(lv_playerIterAlly == PlayerGroupPlayer(auto5169EB00_g, auto5169EB00_p)) ) {
            lv_playerIterAlly = PlayerGroupPlayer(auto5169EB00_g, auto5169EB00_p);
            libNtve_gf_SetAlliance(lv_playerIterAlly, lv_playerIterEnemy, libNtve_ge_AllianceSetting_Enemy);
        }
    }
    PlayerSetAlliance(gv_pLAYER_03_ENEMY, c_allianceIdPower, gv_pLAYER_04_ENEMY, true);
    PlayerSetAlliance(gv_pLAYER_04_ENEMY, c_allianceIdPower, gv_pLAYER_03_ENEMY, true);
    libCOMI_gf_SetAlliedCommandersstartingResources();
    return true;
}

