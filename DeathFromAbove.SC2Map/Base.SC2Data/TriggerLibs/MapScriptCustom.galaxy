//--------------------------------------------------------------------------------------------------
// Trigger: Shard_Spawn2
//--------------------------------------------------------------------------------------------------
bool gt_Shard_Spawn2_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_pLAYER_05_TALDARIM))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "AmonShardA", 0, 3, RegionRandomPoint(RegionFromId(40)));
    UnitGroupLoopBegin(UnitGroup(null, 5, RegionFromId(41), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0));
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        UnitIssueOrder(UnitGroupLoopCurrent(), OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(gv_mothership)), c_orderQueueReplace);
    }
    UnitGroupLoopEnd();
    return true;
}

