//--------------------------------------------------------------------------------------------------
// Trigger: Charging_Finish 1
//--------------------------------------------------------------------------------------------------
bool gt_Charging_Finish1_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((gv_charging_Integer == 100))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(gt_MothershipCharge, false);
    TriggerEnable(TriggerGetCurrent(), false);
    libCOUI_gf_SetProgressBarLabel(StringExternal("Param/Value/7168DC38"));
    libCOUI_gf_SetProgressBarTitle(StringExternal("Param/Value/8BDBF506"));
    libCOUI_gf_SetProgressBarColor(Color(100.00, 0.00, 0.00));
    TriggerQueueEnter();
    SoundPlayForPlayer(SoundLink("Dialogue_TransmissionStart", -1), c_maxPlayers, PlayerGroupAll(), 150.0, 0.0);
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Speech);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(265550710), true, false, "Talk"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", SoundLink("Zaladas_Intro0222", -1), StringExternal("Param/Value/C5622D5C"), StringExternal("Param/Value/111AE9E6"), 0.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Game);
    TriggerQueueExit();
    Wait(2.0, c_timeGame);
    libCOUI_gf_ShowHideProgressBar(false);
    UnitRemove(gv_mothership_Shadow);
    PingDestroy(gv_shadow01);
    SoundPlayForPlayer(SoundLink("UI_ZergWarningPing", -1), c_maxPlayers, PlayerGroupAll(), 180.0, 0.0);
    PingCreate(PlayerGroupAll(), "PingObjective", PointFromId(135147310), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 524287.0);
    gv_mothership_Ping = PingLastCreated();
    PingSetScale(gv_mothership_Ping, 1.0);
    PingSetTooltip(gv_mothership_Ping, StringExternal("Param/Value/82A1D94C"));
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "TalDarimMothership", 0, gv_pLAYER_05_TALDARIM, PointFromId(135147310));
    gv_mothership = UnitLastCreated();
    PingSetUnit(gv_mothership_Ping, gv_mothership);
    UnitSetState(gv_mothership, c_unitStateStunned, true);
    libNtve_gf_SendActorMessageToUnit(gv_mothership, "ModelSwap TalDarimMothership2");
    libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(gv_mothership), c_animNameDefault, "Birth", 0, c_animTimeDefault);
    SoundPlayAtPointForPlayer(SoundLink("Mothership_Birth2", -1), c_maxPlayers, PlayerGroupAll(), PointFromId(135147310), 0.0, 200.0, 0.0);
    Wait(4.6, c_timeGame);
    UnitSetState(gv_mothership, c_unitStateStunned, false);
    libNtve_gf_SendActorMessageToUnit(gv_mothership, "ModelSwap TalDarimMothership");
    libNtve_gf_ClearAnimation(libNtve_gf_MainActorofUnit(gv_mothership), c_animNameDefault);
    SoundPlayAtPointForPlayer(SoundLink("CollectionBeam_ObjectFloatUp", -1), c_maxPlayers, PlayerGroupAll(), PointFromId(135147310), 0.0, 200.0, 0.0);
    libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(gv_projector), c_animNameDefault, "Stand Work End", 0, c_animTimeDefault);
    Wait(6.6, c_timeGame);
    libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(gv_projector), c_animNameDefault, "Stand", c_animFlagPlayForever, c_animTimeDefault);
    SoundPlayForPlayer(SoundLink("UI_ZergWarningPing", -1), c_maxPlayers, PlayerGroupAll(), 180.0, 0.0);
    TriggerEnable(gt_Mothership_UnderAttack, true);
    PingCreate(PlayerGroupAll(), "PingArrow", PointFromId(1468169360), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 3.0);
    PingSetScale(PingLastCreated(), 0.6);
    Wait(0.1, c_timeGame);
    PingCreate(PlayerGroupAll(), "PingArrow", PointFromId(3974855), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 3.0);
    PingSetScale(PingLastCreated(), 0.6);
    Wait(0.1, c_timeGame);
    PingCreate(PlayerGroupAll(), "PingArrow", PointFromId(1180593278), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 3.0);
    PingSetScale(PingLastCreated(), 0.6);
    Wait(0.1, c_timeGame);
    PingCreate(PlayerGroupAll(), "PingArrow", PointFromId(43750232), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 3.0);
    PingSetScale(PingLastCreated(), 0.6);
    Wait(0.1, c_timeGame);
    PingCreate(PlayerGroupAll(), "PingArrow", PointFromId(31094028), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 3.0);
    PingSetScale(PingLastCreated(), 0.6);
    Wait(0.1, c_timeGame);
    PingCreate(PlayerGroupAll(), "PingArrow", PointFromId(133625873), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 3.0);
    PingSetScale(PingLastCreated(), 0.6);
    Wait(0.1, c_timeGame);
    UnitIssueOrder(gv_mothership, OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(133625873)), c_orderQueueReplace);
    gv_mothershipTarget = PointFromId(133625873);
    PathCreateForUnit(PlayerGroupAll(), gv_mothership);
    gv_path1 = PathLastCreated();
    PathSetLineWidth(gv_path1, c_pathLocationWorld, 0.8);
    PathSetLineWidth(gv_path1, c_pathLocationMinimap, 12.0);
    PathSetDestinationUnit(gv_path1, UnitFromId(1384704812));
    PathSetColor(gv_path1, c_pathLocationAll, Color(0.00, 100.00, 0.00));
    PathSetVisible(gv_path1, c_pathLocationAll, true);
    libCOUI_gf_DisplaySingularBossBarVoidCampaign("Assets\\Textures\\btn-unit-protoss-alarak-taldarim-mothership.dds", StringExternal("Param/Value/12CDEB75"), 1000);
    libCOUI_gf_SetSingularBossBarBossVoidCampaign(gv_mothership, true);
    libCOUI_gf_ShowHideSingularBossBarVoidCampaign(true);
    return true;
}

