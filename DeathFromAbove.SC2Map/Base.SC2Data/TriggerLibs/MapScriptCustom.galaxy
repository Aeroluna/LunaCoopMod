bool gt_Charging_Finish3_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((gv_charging_Integer == 100))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(gt_MothershipCharge, false);
    TriggerEnable(TriggerGetCurrent(), false);
    libCOUI_gf_SetProgressBarLabel(StringExternal("Param/Value/5B0C5878"));
    libCOUI_gf_SetProgressBarTitle(StringExternal("Param/Value/881ED5CC"));
    libCOUI_gf_SetProgressBarColor(Color(100.00, 0.00, 0.00));
    TriggerQueueEnter();
    SoundPlayAtPointForPlayer(SoundLink("UI_TransmissionStart", -1), c_maxPlayers, PlayerGroupAll(), PointFromId(135147310), 0.0, 150.0, 0.0);
    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Speech);
