int auto_gf_EscortAttack_lp_tech;
int auto_gf_EscortAttack_minorhybrid;
int auto_gf_EscortAttack_majorhybrid;
int auto_gf_EscortAttack_aa;

void gf_EscortAttack (point lp_spawn, unit lp_target, int lp_resource, int lp_tech, int lp_minorhybrid, int lp_majorhybrid, int lp_aa) {
    auto_gf_EscortAttack_lp_spawn = lp_spawn;
    auto_gf_EscortAttack_lp_target = lp_target;
    auto_gf_EscortAttack_lp_resource = lp_resource;
    auto_gf_EscortAttack_lp_tech = lp_tech;
    auto_gf_EscortAttack_minorhybrid = lp_minorhybrid;
    auto_gf_EscortAttack_majorhybrid = lp_majorhybrid;
    auto_gf_EscortAttack_aa = lp_aa;

    if (auto_gf_EscortAttack_Trigger == null) {
        auto_gf_EscortAttack_Trigger = TriggerCreate("auto_gf_EscortAttack_TriggerFunc");
    }

    TriggerExecute(auto_gf_EscortAttack_Trigger, false, false);
}

bool auto_gf_EscortAttack_TriggerFunc (bool testConds, bool runActions) {
    point lp_spawn = auto_gf_EscortAttack_lp_spawn;
    unit lp_target = auto_gf_EscortAttack_lp_target;
    int lp_resource = auto_gf_EscortAttack_lp_resource;
    int lp_tech = auto_gf_EscortAttack_lp_tech;
    int lp_minorhybrid = auto_gf_EscortAttack_minorhybrid;
    int lp_majorhybrid = auto_gf_EscortAttack_majorhybrid;
    int lp_aa = auto_gf_EscortAttack_aa;

    // Variable Declarations
    unitgroup lv_hybrid;
    string race;
    string aa_unittype;

    // Automatic Variable Declarations
    int auto1EA8BBA9_n;
    int auto1EA8BBA9_i;
    int auto160F7065_n;
    int auto160F7065_i;

    // Variable Initialization
    lv_hybrid = UnitGroupEmpty();

    // Implementation
    if ((libCOMI_gf_GameIsOver() == true)) {
        return true;
    }

    libCOMI_gf_CreateCoopAttackForceatLocationandWaitforthemtospawn2(gv_pLAYER_03_ENEMY, gv_pLAYER_04_ENEMY, lp_resource, lp_tech, lp_spawn, true);
    UnitGroupAddUnitGroup(lv_hybrid, libCOMI_gf_LastCreatedCoopAttackForce());
    auto1EA8BBA9_n = lp_minorhybrid;
    for (auto1EA8BBA9_i = 1; auto1EA8BBA9_i <= auto1EA8BBA9_n; auto1EA8BBA9_i += 1) {
        UnitCreate(1, gv_hybridMinor, c_unitCreateIgnorePlacement, RandomInt(3, 4), lp_spawn, 45.0);
        UnitGroupAdd(lv_hybrid, UnitLastCreated());
    }
    auto160F7065_n = lp_majorhybrid;
    for (auto160F7065_i = 1; auto160F7065_i <= auto160F7065_n; auto160F7065_i += 1) {
        UnitCreate(1, gv_hybridMajor, c_unitCreateIgnorePlacement, RandomInt(3, 4), lp_spawn, 45.0);
        UnitGroupAdd(lv_hybrid, UnitLastCreated());
    }
    auto160F7065_n = lp_aa;
    for (auto160F7065_i = 1; auto160F7065_i <= auto160F7065_n; auto160F7065_i += 1) {
        race = PlayerRace(gv_pLAYER_03_ENEMY);
        if (race == "Prot") {
            aa_unittype = "Phoenix";
        }
        else if (race == "Terr") {
            aa_unittype = "VikingFighter";
        }
        else if (race == "Zerg") {
            aa_unittype = "Corruptor";
        }
        UnitCreate(1, aa_unittype, c_unitCreateIgnorePlacement, RandomInt(3, 4), lp_spawn, 45.0);
        UnitGroupAdd(lv_hybrid, UnitLastCreated());
    }
    AIAttackWaveSetTargetUnit(gv_pLAYER_03_ENEMY, lp_target);
    AIAttackWaveSetTargetUnit(gv_pLAYER_04_ENEMY, lp_target);
    libCOMI_gf_SendAttackWaveusingCoopAttackForce(lv_hybrid, 0, false);
    return true;
}

