    libCOOC_gf_SetAllSoundChannelVolumesCampaign(libCOOC_ge_VolumeChannelModeCampaign_Game);
    TriggerQueueExit();
    Wait(2.0, c_timeGame);
    libCOUI_gf_ShowHideProgressBar(false);
    UnitRemove(gv_mothership_Shadow);
    PingDestroy(gv_shadow01);
    SoundPlayForPlayer(SoundLink("UI_ZergWarningPing", -1), c_maxPlayers, PlayerGroupAll(), 180.0, 0.0);
