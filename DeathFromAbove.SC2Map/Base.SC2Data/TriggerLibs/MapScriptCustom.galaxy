// Attack Wave Functions
//--------------------------------------------------------------------------------------------------

trigger auto_gf_AttackBase_Trigger = null;
point auto_gf_AttackBase_lp_spawn;
int auto_gf_AttackBase_lp_resource;
int auto_gf_AttackBase_lp_tech;
int auto_gf_AttackBase_lp_minorhybrid;
int auto_gf_AttackBase_lp_majorhybrid;

void gf_AttackBase (point lp_spawn, int lp_resource, int lp_tech, int lp_minorhybrid, int lp_majorhybrid) {
    auto_gf_AttackBase_lp_spawn = lp_spawn;
    auto_gf_AttackBase_lp_resource = lp_resource;
    auto_gf_AttackBase_lp_tech = lp_tech;
    auto_gf_AttackBase_lp_minorhybrid = lp_minorhybrid;
    auto_gf_AttackBase_lp_majorhybrid = lp_majorhybrid;

    if (auto_gf_AttackBase_Trigger == null) {
        auto_gf_AttackBase_Trigger = TriggerCreate("auto_gf_AttackBase_TriggerFunc");
    }

    TriggerExecute(auto_gf_AttackBase_Trigger, false, false);
}

bool auto_gf_AttackBase_TriggerFunc (bool testConds, bool runActions) {
    point lp_spawn = auto_gf_AttackBase_lp_spawn;
    int lp_resource = auto_gf_AttackBase_lp_resource;
    int lp_tech = auto_gf_AttackBase_lp_tech;
    int lp_minorhybrid = auto_gf_AttackBase_lp_minorhybrid;
    int lp_majorhybrid = auto_gf_AttackBase_lp_majorhybrid;

    // Variable Declarations
    unitgroup lv_hybrid;

    // Automatic Variable Declarations
    int auto1EA8BBA9_n;
    int auto1EA8BBA9_i;
    int auto160F7065_n;
    int auto160F7065_i;

    // Variable Initialization
    lv_hybrid = UnitGroupEmpty();

    // Implementation
    if ((libCOMI_gf_GameIsOver() == true)) {
        return true;
    }

    libCOMI_gf_CreateCoopAttackForceatLocationandWaitforthemtospawn2(gv_pLAYER_03_ENEMY, gv_pLAYER_04_ENEMY, lp_resource, lp_tech, lp_spawn, true);
    UnitGroupAddUnitGroup(lv_hybrid, libCOMI_gf_LastCreatedCoopAttackForce());
    auto1EA8BBA9_n = lp_minorhybrid;
    for (auto1EA8BBA9_i = 1; auto1EA8BBA9_i <= auto1EA8BBA9_n; auto1EA8BBA9_i += 1) {
        UnitCreate(1, gv_hybridMinor, c_unitCreateIgnorePlacement, RandomInt(3, 4), lp_spawn, 45.0);
        UnitGroupAdd(lv_hybrid, UnitLastCreated());
    }
    auto160F7065_n = lp_majorhybrid;
    for (auto160F7065_i = 1; auto160F7065_i <= auto160F7065_n; auto160F7065_i += 1) {
        UnitCreate(1, gv_hybridMajor, c_unitCreateIgnorePlacement, RandomInt(3, 4), lp_spawn, 45.0);
        UnitGroupAdd(lv_hybrid, UnitLastCreated());
    }
    AIAttackWaveSetTargetPlayer(gv_pLAYER_03_ENEMY, PlayerGroupSingle(gv_pLAYER_01_USER));
    AIAttackWaveSetTargetPlayer(gv_pLAYER_04_ENEMY, PlayerGroupSingle(gv_pLAYER_02_USER));
    libCOMI_gf_SendAttackWaveusingCoopAttackForce(lv_hybrid, 0, false);
    TriggerExecute(gt_AttackWaveTransmissionQ, true, false);
    return true;
}

trigger auto_gf_EscortAttack_Trigger = null;
point auto_gf_EscortAttack_lp_spawn;
unit auto_gf_EscortAttack_lp_target;
