//--------------------------------------------------------------------------------------------------
// Trigger: Fissure_Event
//--------------------------------------------------------------------------------------------------
bool gt_Fissure_Event_Func (bool testConds, bool runActions) {
    int autoCB9371B4_val;

    // Actions
    if (!runActions) {
        return true;
    }

    gv_fissures = RandomInt(1, 3);
    autoCB9371B4_val = gv_fissures;
    if (autoCB9371B4_val == 1) {
        CameraShake(1, "Light", "Earthquake", 1.0, 1.0, 3.0);
        CameraShake(2, "Light", "Earthquake", 1.0, 1.0, 3.0);
        WaterSetState("Vespene_Lava|Alternate Setting", 4.0, c_wtcLinear);
        SoundPlayForPlayer(SoundLink("Event_EarthquakeRumble", -1), c_maxPlayers, PlayerGroupAll(), 180.0, 0.0);
        SoundPlayForPlayer(SoundLink("UI_PingAdvanced_Danger", -1), c_maxPlayers, PlayerGroupAll(), 180.0, 0.0);
        PingCreate(PlayerGroupAll(), "PingWarning", PointFromId(125492154), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 4.0);
        gv_fissure_Ping = PingLastCreated();
        PingSetTooltip(gv_fissure_Ping, StringExternal("Param/Value/6E4E15FC"));
        PingSetScale(gv_fissure_Ping, 0.7);
        Wait(3.0, c_timeGame);
