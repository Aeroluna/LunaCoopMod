        mark = AIMarker(aiUnit, c_MK_FungalGrowth);
        if (FungalGrowthTest(player, aiUnit, mark, gameMark, scanGroup)) {
            // if we want to fungal, unburrow
            ord = AICreateOrder(player, c_AB_BurrowInfestorUp, 0);
            if (!UnitOrderIsValid(aiUnit, ord)) {
