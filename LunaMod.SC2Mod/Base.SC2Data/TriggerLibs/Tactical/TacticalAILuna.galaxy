bool UnitIsSiegeUnit (unit inUnit) {
  string unitType = UnitGetType(inUnit);
  return unitType == c_TU_SiegeTank ||
         unitType == c_TU_SiegeTankSieged ||
         unitType == "StukovInfestedSiegeTankUprooted" ||
         unitType == "StukovInfestedSiegeTank" ||
         unitType == "SiegeTank_BlackOps" ||
         unitType == "SiegeTankSieged_BlackOps" ||
         unitType == "SiegeTankMengsk" ||
         unitType == "SiegeTankMengskSieged" ||
         //unitType == "Liberator_BlackOps" ||
         unitType == "LiberatorAG_BlackOps" ||
         //unitType == "SILiberator" ||
         unitType == "SILiberatorAG" ||
         //unitType == "Liberator" ||
         unitType == "LiberatorAG" ||
         unitType == "Lurker" ||
         unitType == "LurkerBurrowed" ||
         unitType == "LurkerStetmann" ||
         unitType == "LurkerStetmannBurrowed" ||
         unitType == "ImpalerDehaka" ||
         unitType == "ImpalerDehakaBurrowed" ||
         unitType == "SwarmHost" ||
         unitType == "SwarmHostBurrowed" ||
         unitType == "SwarmHostMP" ||
         unitType == "SwarmHostBurrowedMP" ||
         unitType == "SwarmHostSplitB" ||
         unitType == "SwarmHostSplitBBurrowed" ||
         unitType == "DehakaSwarmHost" ||
         unitType == "DehakaSwarmHostBurrowed" ||
         unitType == "DehakaPrimalSwarmHost" ||
         unitType == "DehakaPrimalSwarmHostBurrowed" ||
         unitType == "WarpPrismTaldarim" ||
         unitType == "WarpPrismPhasingTaldarim" ||
         unitType == "ZeratulWarpPrism" ||
         unitType == "ZeratulWarpPrismPhasing" ||
         unitType == "ThorMengsk" ||
         unitType == "ThorMengskSieged" ||
         unitType == "NovaInfestedSiegeTankUprooted" ||
         unitType == "NovaInfestedSiegeTank";
}

include "TriggerLibs/Tactical/TactProtAILuna"
include "TriggerLibs/Tactical/TactTerrAILuna"
include "TriggerLibs/Tactical/TactZergAILuna"
